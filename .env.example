# ==============================================================================
# Project Path Settings
# ==============================================================================

# 项目根目录的绝对路径
# 留空则自动检测（C++ 基于可执行文件位置，Python 基于 __file__ 向上推导）
# PROJECT_ROOT=/home/ymj68520/projects/Forensics/ForensicsProject

# 运行时数据目录 (相对于可执行文件所在目录)
# 默认值: data
DATA_DIR=data

# ==============================================================================
# LLM Integration Settings
# ==============================================================================

# LM Studio / OpenAI-compatible API settings (shared)
LLM_BASE_URL=http://localhost:1234
LLM_ENDPOINT=/v1/chat/completions
LLM_API_KEY=

# Text Model (GPT OSS) - for text content processing
LLM_TEXT_BASE_URL=http://localhost:1234
LLM_TEXT_MODEL=qwen/qwen3.6-35b-a3b
# LLM_TEXT_MODEL=openai/gpt-oss-20b

# ==============================================================================
# Model Deployment Instructions
# ==============================================================================
# Note: For full Graphiti & Knowledge Graph functionality, the following models
# must be loaded simultaneously in your LLM backend (e.g., LM Studio or Ollama):
# 1. Main Reasoning: openai/gpt-oss-20b
# 2. Embedding: text-embedding-nomic-embed-text-v1.5
# ==============================================================================
LLM_TEXT_MAX_TOKENS=4096
LLM_TEXT_TEMPERATURE=0.7

# Vision Model (Qwen3 VL) - for image/video content processing
# LLM_VISION_BASE_URL=http://192.168.31.213:1234
LLM_VISION_BASE_URL=http://localhost:1234
# LLM_VISION_MODEL=qwen/qwen3-vl-4b
LLM_VISION_MODEL=qwen/qwen3.6-35b-a3b
LLM_VISION_MAX_TOKENS=4096
LLM_VISION_TEMPERATURE=0.5

# Common LLM parameters
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# ==============================================================================
# MCP Server Settings
# ==============================================================================

# MCP server configuration
MCP_SERVER_PORT=8890
MCP_SERVER_HOST=localhost

# File access restrictions (comma-separated paths)
# Leave empty to allow all paths
MCP_ALLOWED_PATHS=

# ==============================================================================
# File Analysis Settings
# ==============================================================================

# Maximum content length to send to LLM (in characters)
FILE_ANALYSIS_MAX_CONTENT=10000

# Maximum keywords to extract
FILE_ANALYSIS_MAX_KEYWORDS=10

# ==============================================================================
# Database Settings
# ==============================================================================

# Database paths
DB_OUTPUT_DIR=./output
DB_NAME=forensics.db

# ==============================================================================
# Neo4j / Graphiti Settings
# ==============================================================================

# Neo4j connection (for Graphiti knowledge graph)
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=11111111

# Graphiti will use local LLM from LLM_TEXT_* settings above
# Set to false to use OpenAI instead (requires OPENAI_API_KEY)
GRAPHITI_USE_LOCAL_LLM=true

# Graphiti batch processing
GRAPHITI_BATCH_SIZE=25              # Reduced from 50 to prevent 8096 token overflow
GRAPHITI_MAX_RETRIES=3
GRAPHITI_GROUP_ID=forensics_files

# Token management (prevents Graphiti 8096 context overflow)
# Set to true to include full LLM descriptions (can be 3000+ chars per episode)
GRAPHITI_INCLUDE_FULL_DESC=true
GRAPHITI_MAX_EPISODE_TOKENS=3000    # Per-episode safety limit (~7500 chars)

# ==============================================================================
# Python HTTP Service Settings
# ==============================================================================

PYTHON_HTTP_PORT=8090
PYTHON_HTTP_HOST=0.0.0.0
CPP_BACKEND_URL=http://localhost:8080

# ==============================================================================
# C++ HTTP Server Settings
# ==============================================================================

HTTP_SERVER_PORT=8080
HTTP_SERVER_HOST=0.0.0.0

# ==============================================================================
# Context Window Settings
# ==============================================================================

# LLM context window configuration
LLM_CONTEXT_LENGTH=163840
LLM_RESERVED_TOKENS=512
LLM_CHARS_PER_TOKEN=4.0

# Maximum content to send to LLM (absolute limit in characters)
FILE_ANALYSIS_MAX_CONTENT_LIMIT=50000

# ==============================================================================
# Debug Logging Settings
# ==============================================================================

# Debug output mode: stdout, file, none
DEBUG_OUTPUT_MODE=stdout
DEBUG_LOG_FILE=debug.log

# ==============================================================================
# Logging Settings
# ==============================================================================

LOG_LEVEL=INFO
LOG_FILE=forensics.log

# ==============================================================================
# Performance Settings
# ==============================================================================

# Thread pool size for parallel operations
THREAD_POOL_SIZE=4

# Maximum files to process in batch
MAX_BATCH_SIZE=100


# Final Optimized Settings
THREAD_POOL_SIZE=4
LOG_MAX_DISPLAY_FILES=20
DB_JOURNAL_MODE=WAL

# ==============================================================================
# DLL Analysis Configuration
# ==============================================================================

# Enable or disable DLL analysis feature
DLL_ANALYSIS_ENABLED=true

# C++ backend URL for DLL analysis requests
DLL_CPP_BACKEND_URL=http://localhost:8080

# Request timeout for DLL analysis (in seconds)
DLL_ANALYSIS_TIMEOUT=30
