# ==============================================================================
# Project Path Settings
# ==============================================================================

# 项目根目录的绝对路径
# 留空则自动检测（C++ 基于可执行文件位置，Python 基于 __file__ 向上推导）
PROJECT_ROOT=

# 运行时数据目录 (相对于可执行文件所在目录)
# 默认值: data
DATA_DIR=data

# ==============================================================================
# LLM Integration Settings
# ==============================================================================

# OpenAI-compatible chat endpoint shared by text and vision.
# BASE_URL must NOT include /v1: Python httpx, the C++ client, and Graphiti
# each append /v1 (or join LLM_ENDPOINT). A trailing /v1 becomes /v1/v1/.
# Current deployment: StepFun cloud (step-5-preview, multimodal, 256k context).
# Local LM Studio fallback (load the named models there first):
# LLM_BASE_URL=http://192.168.31.170:1234
# LLM_TEXT_BASE_URL=http://192.168.31.170:1234
# LLM_TEXT_MODEL=nvidia/nemotron-3-nano-omni
# LLM_VISION_BASE_URL=http://192.168.31.170:1234
# LLM_VISION_MODEL=nvidia/nemotron-3-nano-omni
LLM_BASE_URL=https://api.example.com
LLM_ENDPOINT=/v1/chat/completions
LLM_API_KEY=

# Text model. LLM_TEXT_API_KEY is optional: leave it empty to reuse LLM_API_KEY,
# or set it when the text endpoint authenticates with a different key.
LLM_TEXT_BASE_URL=https://api.example.com
LLM_TEXT_API_KEY=
LLM_TEXT_MODEL=step-5-preview
LLM_TEXT_MAX_TOKENS=256000
LLM_TEXT_TEMPERATURE=0.7

# Vision model (image/video content). LLM_VISION_API_KEY likewise falls back to
# LLM_API_KEY, so two providers can each keep their own endpoint and key.
LLM_VISION_BASE_URL=https://api.example.com
LLM_VISION_API_KEY=
LLM_VISION_MODEL=step-5-preview
LLM_VISION_MAX_TOKENS=256000
LLM_VISION_TEMPERATURE=0.5

# Common LLM parameters
LLM_TIMEOUT_SECONDS=600
LLM_MAX_RETRIES=3
# In-flight LLM analyses for the C++ file/event-cluster pipeline and the
# Python case-analysis pipeline (files, reanalysis, clusters, Windows
# artifacts). 1 keeps every call sequential. Raise it only when the chat
# server can serve more than one completion at a time; each C++ worker opens
# its own client because the shared client serialises requests.
LLM_MAX_CONCURRENCY=32
# DeepSeek-style thinking switch ("enabled"/"disabled"), sent as the top-level
# "thinking" request field. Empty = don't send (pure OpenAI body). Set
# "disabled" for default-thinking models (e.g. deepseek-flash) to stop
# reasoning from consuming the max_tokens budget.
LLM_THINKING_MODE=
# Smart event-cluster analysis limit. 0 is an explicit unlimited opt-in.
LLM_MAX_EVENT_CLUSTERS=200

# LLM analysis coverage limits. Defaults are finite; set 0 explicitly only when
# an intentionally unlimited run is required and the host has been sized for it.
# A local 27B model takes ~30-60s per file; 1200 files is ~10-20h at the smart cap.
LLM_MAX_FILES=50
# Smart-selection scan cap. Must be >= LLM_MAX_FILES or it becomes a hidden
# bottleneck; 0 scans every candidate.
LLM_SMART_CANDIDATE_FILES=5000
LLM_MAX_ARTIFACTS=500

# ==============================================================================
# MCP Server Settings
# ==============================================================================

# MCP file access is deny-by-default; provide explicit comma-separated roots.
MCP_SERVER_PORT=8890
MCP_SERVER_HOST=127.0.0.1
MCP_ALLOWED_PATHS=
# 0 in a request uses this finite configured limit; it never means unlimited.
MCP_MAX_READ_BYTES=1048576
MCP_MAX_LIST_ENTRIES=10000

# ==============================================================================
# File Analysis Settings
# ==============================================================================

# Maximum content length to send to LLM (in characters)
FILE_ANALYSIS_MAX_CONTENT=10000
LLM_MAX_CONTENT_LENGTH=10000

# Maximum keywords to extract
FILE_ANALYSIS_MAX_KEYWORDS=10

# ==============================================================================
# Video Content Analysis Settings
# ==============================================================================
# Videos are covered end-to-end by sampling frames at LLM_VIDEO_FPS and
# describing each LLM_VIDEO_SEGMENT_SECONDS window with ONE multi-image vision
# call (serial), then synthesizing the final description. Density is a budget
# dial, not an evidence cut: the whole duration below the cap is always covered.
# Videos longer than LLM_VIDEO_MAX_DURATION_SEC get a metadata-only description
# marked for future backfill; 0 disables the cap. Soundtracks go through the
# SenseVoice STT path below and the transcript joins the video synthesis.
LLM_VIDEO_FPS=1
LLM_VIDEO_SEGMENT_SECONDS=15
LLM_VIDEO_MAX_DURATION_SEC=1800

# ==============================================================================
# Audio Transcription Settings (SenseVoice-small via sherpa-onnx, CPU)
# ==============================================================================
# Standalone audio files and video soundtracks are transcribed (silero VAD
# chunking, serial) and synthesized into the forensic description. The full
# transcript is stored in the task files DB audio_transcripts table;
# descriptions carry the analysis plus duration-banded key excerpts.
# Audio longer than LLM_AUDIO_MAX_DURATION_SEC gets a pending_backfill row
# and a metadata-only description; 0 = no cap.
LLM_AUDIO_MAX_DURATION_SEC=3600
# Dir holding model.int8.onnx/tokens.txt/silero_vad.onnx; empty = auto
# (<python_service>/models/audio). Models are downloaded, never committed.
AUDIO_STT_MODEL_DIR=

# ==============================================================================
# Database Settings
# ==============================================================================

# Database paths. Point DB_OUTPUT_DIR at the build data dir the C++ server writes.
DB_OUTPUT_DIR=build/data
DB_NAME=forensics.db

# ==============================================================================
# Neo4j / Graphiti Settings
# ==============================================================================

# Neo4j connection (for Graphiti knowledge graph)
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Redis (optional; IngestionJobManager falls back to in-memory when unreachable).
# Password form: redis://:password@localhost:6379 — never commit a real password.
REDIS_URL=redis://localhost:6379

# Graphiti uses the local ingestion model below, not the cloud LLM_TEXT_* chat.
# Set to false to use OpenAI instead (requires OPENAI_API_KEY).
GRAPHITI_USE_LOCAL_LLM=true

# Graphiti batch processing. BATCH_SIZE is how many rows are read from SQLite
# per pass; it does not parallelise the LLM extraction.
GRAPHITI_BATCH_SIZE=50
# In-flight add_episode calls inside one ingestion batch. 1 keeps extraction
# sequential, which Graphiti's in-group dedup assumes. Values above 1 run that
# many extractions at once and can create duplicate entities within the group.
GRAPHITI_MAX_CONCURRENCY=32
GRAPHITI_MAX_RETRIES=3
GRAPHITI_GROUP_ID=forensics_files

# Include full LLM descriptions in each episode (richer entities, more tokens).
GRAPHITI_INCLUDE_FULL_DESC=true
# Per-episode budget. Match the ingestion model's context (phi-4 / cloud 256k).
GRAPHITI_MAX_EPISODE_TOKENS=256000

# ==============================================================================
# Python HTTP Service Settings
# ==============================================================================

PYTHON_HTTP_PORT=8090
PYTHON_HTTP_HOST=0.0.0.0
CPP_BACKEND_URL=http://localhost:8666
CPP_STARTUP_REQUEST_TIMEOUT=5
CPP_RECOVERY_TIMEOUT=8
NEO4J_CONNECT_TIMEOUT=5
NEO4J_QUERY_TIMEOUT=5
OPTIONAL_SERVICE_INIT_TIMEOUT=12
PYTHON_STARTUP_TIMEOUT=30

# ==============================================================================
# C++ HTTP Server Settings
# ==============================================================================

HTTP_SERVER_PORT=8666
HTTP_SERVER_HOST=0.0.0.0

# ==============================================================================
# Context Window Settings
# ==============================================================================

# LLM context window configuration (step-5-preview: 256k)
LLM_CONTEXT_LENGTH=256000
LLM_RESERVED_TOKENS=512
LLM_CHARS_PER_TOKEN=4.0

# Maximum content to send to LLM (absolute limit in characters)
FILE_ANALYSIS_MAX_CONTENT_LIMIT=12000

# ==============================================================================
# Debug Logging Settings
# ==============================================================================

# Debug output mode: stdout, file, none
DEBUG_OUTPUT_MODE=stdout
DEBUG_LOG_FILE=debug.log

# ==============================================================================
# Logging Settings
# ==============================================================================

LOG_LEVEL=INFO
LOG_FILE=forensics.log

# ==============================================================================
# Performance Settings
# ==============================================================================

# Thread pool size for parallel operations
THREAD_POOL_SIZE=4

# Maximum files to process in batch
MAX_BATCH_SIZE=100


# Final Optimized Settings
THREAD_POOL_SIZE=4
LOG_MAX_DISPLAY_FILES=20
DB_JOURNAL_MODE=WAL

# ==============================================================================
# DLL Analysis Configuration
# ==============================================================================

# Enable or disable DLL analysis feature
DLL_ANALYSIS_ENABLED=true

# C++ backend URL for DLL analysis requests
DLL_CPP_BACKEND_URL=http://localhost:8666

# Request timeout for DLL analysis (in seconds)
DLL_ANALYSIS_TIMEOUT=30

# ==============================================================================
# Phase-1 Acceptance MVP switches (docs/specs/mvp-phase1-acceptance.md)
# ==============================================================================

# Graphiti ingestion LLM. PINNED to phi-4 by default (non-reasoning instruct
# model); set explicitly to override. Never falls back to LLM_TEXT_MODEL.
GRAPHITI_LLM_MODEL=microsoft/phi-4
# Ingestion server override. Empty follows LLM_TEXT_BASE_URL, which sends
# graph extraction to the cloud chat above. Point it at the local LM Studio
# that has phi-4 loaded when the main analysis LLM is cloud-hosted.
GRAPHITI_LLM_BASE_URL=http://192.168.31.170:1234
# Ingestion API key. Empty follows LLM_TEXT_API_KEY, then LLM_API_KEY. Set it
# when the ingestion server authenticates separately from text and vision.
GRAPHITI_LLM_API_KEY=

# Embeddings. Unset, these fall back to LLM_BASE_URL, which has no /embeddings
# endpoint and no nomic model — ingestion then fails. Keep them on the local
# LM Studio even when chat is cloud. EMBEDDING_DIM defaults to 768 and must
# match the existing Neo4j index; changing the model means rebuilding the graph.
EMBEDDING_BASE_URL=http://192.168.31.170:1234
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# Embedding API key. Empty follows GRAPHITI_LLM_API_KEY, then LLM_TEXT_API_KEY,
# then LLM_API_KEY. Set it when the embedding server is a separate provider.
EMBEDDING_API_KEY=

# Structured-output response_format for Graphiti extraction. json_schema is
# decoded by LM Studio (better than injecting the schema into the prompt).
# Providers that reject json_schema with a hard 400 (e.g. DeepSeek) need
# json_object — the schema then rides in the system prompt instead.
GRAPHITI_STRUCTURED_OUTPUT_MODE=json_schema

# Event (cluster) LLM analysis — disabled in the MVP (events stay raw data)
EVENT_LLM_ANALYSIS_ENABLED=false

# Combined-case (multi-image) feature — disabled in the MVP
COMBINED_CASE_ENABLED=false

# Workbench LLM secondary analysis / event re-summary — disabled in the MVP.
# Event re-summary and the graph tab follow this flag only.
WORKBENCH_LLM_ENABLED=false
# Secondary analysis alone. Unset follows WORKBENCH_LLM_ENABLED.
SECONDARY_ANALYSIS_ENABLED=false

# Windows/Linux artifact LLM analysis (the post-extraction platform pipeline in
# the C++ WindowsFilesAnalyzer / LinuxFilesAnalyzer) — disabled in the MVP
# (§4.8). Structured extraction and llm_*-NULL display are unaffected; Android
# artifact analysis is not governed by this flag.
WIN_LINUX_ARTIFACT_LLM_ENABLED=false

# C++ FINALIZING waits for the Graphiti ingestion job before completing a task
# (minutes; 0 restores the legacy fire-and-forget completion). Retries and the
# poll interval are tuned via GRAPHITI_INGEST_RETRIES / GRAPHITI_INGEST_POLL_SECONDS.
GRAPHITI_INGEST_WAIT_TIMEOUT_MIN=720

# ==============================================================================
# Setup-time model downloads (used by setup.sh; both default on)
# ==============================================================================

# Offline EN→ZH translation overlay: Argos en_zh 1.9 (OPUS-MT via CTranslate2,
# ~67 MB) installed into build/models/translate-en_zh-1_9. 0 = skip download.
INSTALL_INITIAL_ANALYSIS_TRANSLATION_MODEL=1

# Audio transcription models: SenseVoice-small int8 (~239 MB) + silero VAD,
# installed into python_service/models/audio. 0 = skip download.
INSTALL_AUDIO_STT_MODEL=1

# ==============================================================================
# Aliyun OSS (Object Storage Service) Settings
# ==============================================================================

# OSS authentication credentials
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# OSS endpoint (e.g., oss-cn-hangzhou.aliyuncs.com)
OSS_ENDPOINT=

# OSS region (default: cn-hangzhou)
OSS_REGION=cn-hangzhou

# ==============================================================================
# Python Service CORS Settings
# ==============================================================================

# Allowed CORS origins (JSON array format)
# Default: ["*"] (allow all origins)
# Example: ["https://example.com", "https://app.example.com"]
PYTHON_CORS_ORIGINS=["*"]

# Distributed C/S server uses CS_* as the canonical names.
CS_HOST=127.0.0.1
CS_PORT=8091
# PORT is accepted only for backwards compatibility and should be omitted.
JWT_SECRET_KEY=change-me-generate-a-unique-secret
JWT_ALGORITHM=HS256
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/tracelens
DB_CONNECT_TIMEOUT=5
DB_POOL_TIMEOUT=5
DB_STARTUP_TIMEOUT=30
