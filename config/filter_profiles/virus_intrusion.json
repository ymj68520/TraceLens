{
    "profile_name": "virus_intrusion",
    "description": "Virus/malware intrusion investigation - focuses on executables, scripts, configs, logs, persistence mechanisms",
    "version": "1.0.0",

    "include": {
        "extensions": [
            ".exe", ".dll", ".sys", ".drv", ".com", ".scr", ".bat", ".cmd",
            ".ps1", ".psm1", ".psd1", ".vbs", ".vbe", ".js", ".jse", ".wsf",
            ".msi", ".msp", ".mst", ".cpl", ".hta", ".inf", ".reg",
            ".sh", ".bash", ".py", ".rb", ".pl", ".php", ".cgi",
            ".elf", ".so", ".ko", ".bin",
            ".jar", ".class", ".war",
            ".doc", ".docx", ".xls", ".xlsx", ".pdf", ".rtf",
            ".html", ".htm", ".js", ".css",
            ".log", ".txt", ".conf", ".cfg", ".ini", ".yaml", ".yml",
            ".json", ".xml",
            ".db", ".sqlite", ".sqlite3",
            ".key", ".pem", ".crt", ".cer", ".p12", ".pfx", ".jks",
            ".dat", ".bak",
            ".lnk", ".url"
        ],
        "path_patterns": [
            "/etc/*",
            "/etc/init.d/*", "/etc/cron*/*", "/etc/systemd/*",
            "/etc/ssh/*", "/etc/sudoers*",
            "/var/log/*", "/var/tmp/*", "/var/spool/*",
            "/tmp/*", "/dev/shm/*",
            "/root/*", "/home/*",
            "*/.ssh/*", "*/.gnupg/*",
            "*/autorun*", "*/startup*",
            "*/Startup/*",
            "*/Windows/System32/*", "*/Windows/SysWOW64/*",
            "*/Windows/Temp/*", "*/Windows/Prefetch/*",
            "*/AppData/Local/Temp/*",
            "*/AppData/Roaming/Microsoft/Windows/Start Menu/*",
            "*/ProgramData/*",
            "*/.bash_history", "*/.zsh_history",
            "*/.bashrc", "*/.profile", "*/.zshrc",
            "*/crontab*", "*/cron.d/*",
            "*/.config/autostart/*"
        ],
        "filename_patterns": [
            "autorun.inf", "desktop.ini",
            "*.vbs", "*.vbe", "*.js", "*.jse",
            "*.ps1", "*.bat", "*.cmd",
            "crontab*", "*.service", "*.timer",
            "id_rsa*", "id_ed25519*", "authorized_keys",
            ".htaccess", ".htpasswd",
            "*.key", "*.pem"
        ],
        "min_size": 0,
        "max_size": 524288000,
        "include_deleted": true,
        "include_allocated": true
    },

    "exclude": {
        "extensions": [],
        "path_patterns": [
            "/proc/*", "/sys/*", "/dev/*", "/run/*",
            "*/node_modules/*", "*/__pycache__/*",
            "*/.git/objects/*"
        ],
        "filename_patterns": []
    },

    "combine_mode": "exclude_wins"
}
