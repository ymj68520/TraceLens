# 6C LAN profile: the same loopback backends, via an approved HTTPS gateway.
# Real hostname, certificate, trust and Windows/WSL forwarding need separate approval.
# Copy outside Git as owner-only 0600 and replace all REPLACE_* values.
TRACELENS_FIELD_AUTH=enabled
TRACELENS_REQUIRE_FIELD_AUTH=1
TRACELENS_REQUIRE_RELEASE_LAYOUT=1
TRACELENS_RELEASE_ID=REPLACE_RELEASE_ID
TRACELENS_RELEASE_ROOT=/opt/tracelens/releases/REPLACE_RELEASE_ID
TRACELENS_PYTHON_BIN=/opt/tracelens/releases/REPLACE_RELEASE_ID/python_service/.venv/bin/python
FIELD_OUTBOUND_POLICY=disabled
FIELD_MODEL_ORIGINS=
FIELD_BROWSER_ORIGIN=https://REPLACE_APPROVED_HOSTNAME
FIELD_AUTH_URL=http://127.0.0.1:8090
FIELD_USER_FILE=/srv/tracelens-field/secrets/users.json
FIELD_JWT_SECRET=REPLACE_WITH_INDEPENDENT_48_PLUS_RANDOM_BYTES
FIELD_CPP_TO_PYTHON_TOKEN=REPLACE_WITH_INDEPENDENT_48_PLUS_RANDOM_BYTES
FIELD_PYTHON_TO_CPP_TOKEN=REPLACE_WITH_INDEPENDENT_48_PLUS_RANDOM_BYTES
HTTP_SERVER_HOST=127.0.0.1
HTTP_SERVER_PORT=8666
PYTHON_HTTP_HOST=127.0.0.1
PYTHON_HTTP_PORT=8090
CPP_BACKEND_URL=http://127.0.0.1:8666
PYTHON_SERVICE_URL=http://127.0.0.1:8090
DATA_DIR=/srv/tracelens-field/data
TRACELENS_LOG_ROOT=/srv/tracelens-field/data/logs
FORENSIC_REPORT_DIR=/srv/tracelens-field/data/reports
LLM_ENABLED=false
GRAPHITI_ENABLED=false
WORKBENCH_LLM_ENABLED=false
LLM_BASE_URL=
LLM_TEXT_BASE_URL=
LLM_VISION_BASE_URL=
EMBEDDING_BASE_URL=
OSS_ENDPOINT=
TRACELENS_QNXPROBE_ROOT=/opt/tracelens/releases/REPLACE_RELEASE_ID/.deps/qnxprobe
# Backends remain loopback and authenticated. No public direct 8090/8091.
